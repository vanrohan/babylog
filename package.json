{
  "name": "babylog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "playwright test",
    "test:services": "node --import tsx scripts/check-services.ts",
    "build:compute": "npm run build && node --import tsx scripts/build-compute.ts",
    "test:cloud": "node --import tsx scripts/check-cloud.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@ncdai/react-wheel-picker": "1.2.3",
    "echarts": "^6.1.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typebox": "1.3.27",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@prisma/composer": "0.39.0",
    "@prisma/composer-prisma-cloud": "0.39.0",
    "@types/bun": "1.4.4",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prisma": "8.0.0-rc.34",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
